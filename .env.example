PORT=3000

# --- Supabase Postgres ---
# Paste your Supabase connection string and fill in the password.
# Direct connection (port 5432) works for a long-running Render service.
# For serverless you'd use the pooler (port 6543) instead.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.kzqagavdebohizbyfmxo.supabase.co:5432/postgres
# "require" for Supabase (TLS, no cert verification). Use "disable" for a local Postgres.
DATABASE_SSL=require

# --- Admin panel (gear icon) login ---
ADMIN_USERNAME=kitten
ADMIN_PASSWORD=1707

# --- Session cookie signing secret: set a long random value in production ---
JWT_SECRET=change-me-to-a-long-random-string

# Seed value for the X-AUTH-TOKEN header on first boot only.
# After first run it lives in the DB and is edited from the admin panel.
WINTWEALTH_AUTH_TOKEN=

NODE_ENV=production
