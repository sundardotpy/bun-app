# Copy to .env.local for local development. On Vercel, set these under
# Settings → Environment Variables instead (a redeploy is needed to apply them).

# --- Report API config (no database; this is the source of truth) ---
# Reports (Master/Taxation) auth token, sent as X-AUTH-TOKEN. Required.
WINTWEALTH_AUTH_TOKEN=your-reports-token

# Optional overrides.
AGENT_ID=333
WINTWEALTH_BASE_URL=https://elb.api.wintwealth.com

# Optional: extra hosts /api/download is allowed to stream files from.
# Comma-separated, suffix-matched. wintwealth.com and amazonaws.com are always
# allowed; add anything else the report URLs point at (e.g. a CDN domain).
# DOWNLOAD_ALLOWED_HOSTS=cdn.example.com
